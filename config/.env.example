# canvodpy credentials — copy to config/.env (gitignored) and fill in values.
#
# config/.env is loaded automatically by canvodpy at startup (alongside
# any CANVOD__* environment variables already set in the shell).
# Values here override the matching fields in config/canvod-settings.yaml.
#
# Format: CANVOD__<SECTION>__<SUBSECTION>__<FIELD>=value
# Nested delimiter is double-underscore (__).

# NASA Earthdata email — required for NASA CDDIS SP3/CLK downloads.
# Register at: https://urs.earthdata.nasa.gov/users/new
CANVOD__PROCESSING__CREDENTIALS__NASA_EARTHDATA_ACC_MAIL=your.email@example.com
