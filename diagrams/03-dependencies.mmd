graph TD
    subgraph Foundation["Foundation Layer (0 inter-package deps)"]
        Utils["canvod-utils"]
        Config["canvod-config"]
        Readers["canvod-readers"]
        Grids["canvod-grids"]
        VOD["canvod-vod"]
        NAMING["canvod-preflight"]
    end

    subgraph Consumers["Consumer Layer"]
        Aux["canvod-auxiliary"]
        Store["canvod-store"]
        StoreMeta["canvod-store-metadata"]
        Viz["canvod-viz"]
        OPS["canvod-ops"]
    end

    subgraph Orchestration["Orchestration Layer"]
        Canvodpy["canvodpy"]
    end

    Canvodpy ==> Readers
    Canvodpy ==> Aux
    Canvodpy ==> Store
    Canvodpy ==> VOD
    Canvodpy ==> Grids
    Canvodpy ==> Viz
    Canvodpy ==> OPS
    Canvodpy ==> StoreMeta
    Canvodpy ==> Config

    Aux -.-> Readers
    Aux -.-> Config
    Store -.-> Grids
    Store -.-> Config
    StoreMeta -.-> Utils
    StoreMeta -.-> Config
    Viz -.-> Grids
    OPS -.-> Grids
    OPS -.-> Utils
    OPS -.-> Config
    Readers -.-> Config
    NAMING -.->|standalone CLI, not imported by canvodpy| Store
